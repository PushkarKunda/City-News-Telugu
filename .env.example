# -----------------------------------------------------------------------------
# Runtime configuration example for local development
# Copy this file to `.env` (do NOT commit secrets)
# -----------------------------------------------------------------------------

# Backend API
EXPO_PUBLIC_API_BASE_URL=https://hypernews-production.up.railway.app
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_USE_MOCKS=false

# -----------------------------------------------------------------------------
# Supabase (frontend-safe keys)
# - Use EXPO_PUBLIC_SUPABASE_* for client-side usage
# - Keep service role keys only on your backend (do NOT put service role in frontend)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_BUCKET=new-images
# SUPABASE_SERVICE_ROLE_KEY=    # <-- backend-only secret (never in frontend)

# -----------------------------------------------------------------------------
# Firebase (client config) - put these in your frontend `.env`
# For phone auth, Google sign-in, and storage usage
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google OAuth client IDs used by Firebase Google sign-in
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=849371654758-oc0ne88p18ikcdamc7ns62ve8caa7n6e.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=849371654758-jb831p3e0mv4n8bupaep4cu691ifbpr5.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=849371654758-oc0ne88p18ikcdamc7ns62ve8caa7n6e.apps.googleusercontent.com
EXPO_PUBLIC_DEV_TEST_TOKEN=

# -----------------------------------------------------------------------------
# Push / Notifications
# - FCM server key must be kept on backend only
# - For Expo managed apps you may also need Expo push credentials
# -----------------------------------------------------------------------------
# BACKEND_ONLY_FCM_SERVER_KEY=    # <-- backend-only secret
# EXPO_PUSH_TOKEN environment is set per device at runtime; use expo-notifications

# -----------------------------------------------------------------------------
# Native config files
# - Place `google-services.json` (Android) and `GoogleService-Info.plist` (iOS)
#   in your native app or configure them via Expo's credentials management.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Notes
# - Use `.env.local` or CI secrets for real values. Do NOT commit secrets.
# - Prefix public client vars with `EXPO_PUBLIC_` so Expo exposes them to the JS bundle.
# -----------------------------------------------------------------------------
