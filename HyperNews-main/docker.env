# Optional: extra environment variables for api and celery-worker.
# DATABASE_URL, REDIS_URL, CELERY_BROKER_URL, and CELERY_RESULT_BACKEND are set in docker-compose.yml.
# Uncomment and fill in as needed (or duplicate lines from your local .env):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Notification retention (scheduler, in days):
# NOTIFICATION_READ_RETENTION_DAYS=90
# NOTIFICATION_UNREAD_RETENTION_DAYS=365
