# Environment
ENVIRONMENT=development
DEBUG=False

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
AUTO_CREATE_TABLES=false

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security (⚠️ CHANGE THESE VALUES IN PRODUCTION ⚠️)
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
SESSION_SECRET_KEY=your-different-secret-key-change-this-in-production-min-32-chars
ALLOWED_HOSTS=api.yourdomain.com,www.yourdomain.com

# CORS (change to your frontend domain in production)
CORS_ALLOW_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Google OAuth (Get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Service - Brevo (Get API key from brevo.com)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=YourApp
BREVO_SMS_SENDER=YOURAPP

# SMTP Fallback (Optional - for development)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Firebase Cloud Messaging (⚠️ Do NOT commit firebase JSON to repo)
# Option 1: Use environment variable with JSON string
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project"}
# Option 2: Or use file path (on Linux/Docker use absolute path without drive letter)
# FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json